# Copy to docker/.env, fill in on the SERVER only, then: chmod 600 docker/.env
# Owner dashboard / API token (generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))")
ATM_OWNER_TOKEN=
# Binance Spot TESTNET keys from https://testnet.binance.vision (never real-account keys)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Telegram (optional): bot token from @BotFather and YOUR numeric user id (from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Cost tracking assumptions (USD/month) — leave 0 until you approve a purchase
ATM_VPS_MONTHLY_USD=0
ATM_CLAUDE_BUDGET_USD=0
